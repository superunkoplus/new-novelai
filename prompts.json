:root { --bg:#f0f2f5; --fg:#1a1a1a; --card:#fff; --line:#d5d9e0; --accent:#2563eb; --soft:#eff6ff; --var:#fef9c3; --danger:#dc2626; --muted:#64748b; }
@media (prefers-color-scheme: dark) {
  :root { --bg:#1a1b1e; --fg:#ececec; --card:#2c2e33; --line:#3f424a; --accent:#7aa2ff; --soft:#243056; --var:#4a3f1f; --danger:#f87171; --muted:#a0a8b4; }
}
* { box-sizing:border-box; }
body { margin:0; background:var(--bg); color:var(--fg); font-family:-apple-system,"Hiragino Sans",Meiryo,sans-serif; }
button { font:inherit; font-size:16px; color:var(--fg); background:var(--card); border:1px solid var(--line); border-radius:10px; padding:11px 15px; cursor:pointer; }
button:active { opacity:.7; }
#top { position:sticky; top:0; z-index:10; background:var(--bg); padding:10px 12px 6px; border-bottom:1px solid var(--line); }
#chips { display:flex; flex-wrap:wrap; gap:6px; min-height:48px; max-height:120px; overflow-y:auto; padding:8px; background:var(--card); border:1px solid var(--line); border-radius:12px; }
.hint { color:var(--muted); font-size:15px; }
.chip { display:inline-flex; gap:5px; align-items:center; background:var(--soft); color:var(--accent); border-radius:16px; padding:5px 12px; font-size:14px; cursor:pointer; }
.chip b { background:var(--accent); color:var(--bg); border-radius:8px; padding:0 5px; font-size:10px; }
.actions { display:flex; gap:8px; margin:8px 0; }
.actions button { flex:1; font-weight:600; }
#copy { background:var(--accent); color:#fff; border-color:var(--accent); }
#clear { color:var(--danger); border-color:var(--danger); }
#tabs { display:flex; gap:6px; overflow-x:auto; padding-bottom:6px; }
#tabs button { white-space:nowrap; padding:9px 13px; }
#tabs .active { background:var(--accent); color:#fff; border-color:var(--accent); }
#content { padding:4px 12px 40px; }

.buttons { display:flex; flex-wrap:wrap; gap:8px; }
.buttons .var { background:var(--var); }
.on { background:var(--soft) !important; border-color:var(--accent) !important; color:var(--accent); }
#overlay { position:fixed; inset:0; z-index:20; background:rgba(0,0,0,.5); display:flex; align-items:flex-end; justify-content:center; }
#overlay[hidden] { display:none; }
#panel { background:var(--card); width:100%; max-width:520px; max-height:80vh; overflow-y:auto; border-radius:20px 20px 0 0; padding:18px; display:flex; flex-direction:column; gap:8px; }
#panel h3 { margin:0 0 6px; font-size:16px; }
#panel button { text-align:left; background:var(--bg); }
#panel small { display:block; color:var(--muted); font-size:14px; margin-top:2px; }
#panel .danger { color:var(--danger); }
#panel .close { text-align:center; margin-top:6px; }
.item { display:inline-flex; }
.item > button:first-child { border-radius:10px 0 0 10px; border-right:none; }
.item > .q { border-radius:0 10px 10px 0; padding:11px 11px; color:var(--muted); }
#panel p { margin:4px 0; font-size:15px; }
#panel .note { color:var(--danger); }
#panel .sub { color:var(--muted); font-size:13px; margin-top:8px; }
#panel code { display:block; background:var(--bg); padding:10px; border-radius:8px; font-size:14px; word-break:break-all; }
.moverow { display:flex; gap:8px; }
.moverow button { flex:1; text-align:center !important; }
.sechead { display:block; width:100%; text-align:left; margin:8px 0 0; font-weight:600; background:var(--card); }
.sechead.open { color:var(--accent); border-color:var(--accent); }
.buttons { margin:8px 0 12px; }
.chip.pinned { outline:2px solid var(--accent); }
#unpin[hidden] { display:none; }
